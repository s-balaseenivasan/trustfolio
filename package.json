{
  "name": "trustfolio",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test:unit": "tsx --test src/lib/approval/definition.test.ts src/lib/validations/fundraising.test.ts src/lib/validations/donations.test.ts src/server/payments/provider.test.ts src/lib/finance/chart.test.ts src/lib/finance/journal-core.test.ts",
    "check": "npm run lint && npm run typecheck && npm run test:unit && npm run build",
    "check:db": "npm run test:approval:db && npm run test:club:db && npm run test:volunteer:db && npm run test:project:db && npm run test:fundraising:db && npm run test:donations:db",
    "test:recovery": "tsx scripts/verify-recovery.ts",
    "test:workflow": "tsx scripts/verify-portal-workflow-ui.ts",
    "test:approval": "tsx --test src/lib/approval/definition.test.ts",
    "test:approval:db": "tsx scripts/verify-approval-migration.ts",
    "test:approval:headed": "tsx scripts/verify-approval-ui.ts",
    "test:club:db": "tsx scripts/verify-club-migration.ts",
    "test:club:headed": "tsx scripts/verify-club-ui.ts",
    "test:volunteer:db": "tsx scripts/verify-volunteer-migration.ts",
    "test:volunteer:headed": "tsx scripts/verify-volunteer-ui.ts",
    "test:project:db": "tsx scripts/verify-project-migration.ts",
    "test:project:headed": "tsx scripts/verify-project-ui.ts",
    "test:fundraising": "tsx --test src/lib/validations/fundraising.test.ts",
    "test:donations": "tsx --test src/lib/validations/donations.test.ts src/server/payments/provider.test.ts",
    "test:finance-core": "tsx --test src/lib/finance/*.test.ts",
    "test:donations:db": "tsx scripts/verify-donations-migration.ts",
    "test:donations:headed": "tsx scripts/verify-donations-ui.ts",
    "test:fundraising:db": "tsx scripts/verify-fundraising-migration.ts",
    "test:fundraising:headed": "tsx scripts/verify-fundraising-ui.ts",
    "postinstall": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:seed": "prisma db seed",
    "db:reset": "prisma migrate reset",
    "db:studio": "prisma studio",
    "admin:create": "tsx scripts/create-admin.ts",
    "vercel-build": "prisma generate && prisma migrate deploy && next build",
    "db:seed:demo": "tsx scripts/seed-demo.ts",
    "db:demo:clear": "tsx scripts/clear-demo.ts",
    "db:reset-demo": "tsx scripts/clear-demo.ts && tsx scripts/seed-demo.ts",
    "demo:assets": "node scripts/generate-demo-assets.mjs",
    "db:audit-demo": "tsx scripts/audit-demo.ts"
  },
  "dependencies": {
    "@prisma/adapter-pg": "^7.10.0",
    "@prisma/client": "^7.10.0",
    "@vercel/blob": "^2.9.0",
    "bcryptjs": "^3.0.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "dotenv": "^18.0.4",
    "geist": "^1.7.2",
    "lucide-react": "^1.49.0",
    "motion": "^13.4.6",
    "next": "16.4.6",
    "next-auth": "^5.0.0-beta.32",
    "next-themes": "^0.4.6",
    "pg": "^8.23.0",
    "radix-ui": "^1.6.7",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "server-only": "^0.0.1",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.7.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@tailwindcss/postcss": "^4",
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^20",
    "@types/pg": "^8.23.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.4.6",
    "prisma": "^7.10.0",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "tw-animate-css": "^1.4.0",
    "typescript": "^5"
  },
  "engines": {
    "node": ">=20.9.0"
  },
  "overrides": {
    "@vercel/cli-config": {
      "zod": "^4.6.7"
    },
    "@typescript-eslint/typescript-estree": {
      "minimatch": "^11.0.8"
    }
  }
}
